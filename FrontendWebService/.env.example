# FrontendWebService environment variables
# Copy this file to .env and adjust values as needed.

# Public base URL for the Backend API Service
# Example for local dev:
# http://localhost:8000
NEXT_PUBLIC_API_URL=

# Public origin of the Frontend app (used for OAuth redirect hints if needed)
# Example for local dev:
# http://localhost:3000
NEXT_PUBLIC_APP_ORIGIN=
